<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA Task//EN" "task.dtd">
<task id="how_to_subtract_numbers">
    <title>How to sum-up numbers</title>
    <shortdesc>Here you will find instructions about using the sum-up feature of JPS
        calculator</shortdesc>
    <taskbody>
        <prereq id="prereq_fmq_m3k_5fc">
            <p>To sucessfully sum-up numbers, you must know what is sum-up</p>
        </prereq>
        <context id="context_idh_sgl_5fc"/>
        <steps id="steps_jdh_sgl_5fc">
            <step>
                <cmd>Enter the first number.</cmd>
            </step>
            <step>
                <cmd>Choose  the plus (+) button.</cmd>
            </step>
            <step>
                <cmd>Enter the second number.</cmd>
            </step>
            <step>
                <cmd>Choose the equlas (=) button.</cmd>
            </step>
        </steps>
        <result id="result_nyf_djk_5fc">
            <p>The results from Sum-up are displayed</p>
        </result>
        <example id="example_sm3_hjk_5fc">
            <p>You want to add 2 from 3 . The equation will look like 3+2=5. You enter 3 , press + ,
                enter 2, press equlas</p>
            <p>The result 5 displays on screen</p>
        </example>
    </taskbody>
</task>
