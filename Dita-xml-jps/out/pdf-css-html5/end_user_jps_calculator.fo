retrieve-boundary="document" retrieve-position="first-including-carryover"/><fo:retrieve-marker retrieve-class-name="sectiontitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/> | <fo:page-number/></fo:block></fo:table-cell></fo:table-row></fo:table-body></fo:table></fo:static-content><fo:static-content flow-name="xsl-footnote-separator" role="artifact" text-align="left" display-align="auto" font-size="10pt" font-family="Roboto , sans-serif" border-top-style="solid" border-top-color="black" border-top-width="thin" padding-top="8pt"><fo:block/></fo:static-content><fo:flow flow-name="xsl-region-body"><fo:block font-family="serif" font-size="12px" min-width="100%" xml:lang="en"><fo:block-container font-family="Roboto, sans-serif" font-size="10pt" margin-left="0" margin-right="0" min-width="100%"><fo:block end-indent="0" start-indent="0"><fo:block-container color="rgb(0 , 0 , 0)" line-height="1.7em" space-after="80px"><fo:block end-indent="0" start-indent="0"><fo:block><fo:block-container space-after="80px"><fo:block end-indent="0" start-indent="0"><fo:block xml:lang="en"><fo:block-container space-before="1em" id="d98e86"><fo:block end-indent="0" start-indent="0" role="Sect">
                            <fo:block-container font-size="2em" line-height="1.1em" space-after="0.5em" margin-left="0" margin-right="0" space-before="0" page-break-after="avoid" id="ariaid-title10"><fo:block end-indent="0" start-indent="0" role="H1"><fo:marker marker-class-name="chaptertitle-only"><fo:inline/> <!--content(text)--><fo:inline>multiply</fo:inline></fo:marker><fo:marker marker-class-name="chaptertitle-no-prefix"><fo:inline/> 4 - <!--content(text)--><fo:inline>multiply</fo:inline></fo:marker><fo:marker marker-class-name="chaptertitle"><fo:inline/> | 4 - <!--content(text)--><fo:inline>multiply</fo:inline></fo:marker><fo:inline>Chapter 4. </fo:inline><fo:inline>multiply</fo:inline></fo:block></fo:block-container>
                            <fo:block role="Sect" id="unique_7" chfox:nd-id="what_is_subtract_of_numbers">
                                <fo:block-container font-size="1.7em" space-after="0.5em" margin-left="0" margin-right="0" space-before="1em" page-break-after="avoid" id="ariaid-title11"><fo:block end-indent="0" start-indent="0" role="H2"><fo:inline>What is multiply of numbers</fo:inline></fo:block></fo:block-container>
                                <fo:block-container space-after="0" margin-left="0" margin-right="0" space-before="0"><fo:block end-indent="0" start-indent="0">
                                    <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="0.5em"><fo:block end-indent="0" start-indent="0">Here you will
                                        learn what is multiplication</fo:block></fo:block-container>
                                    <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">Multiplication is
                                        the process of adding a number to itself a certain number of
                                        times. </fo:block></fo:block-container>
                                    <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">On a calculator,
                                        you enter the<fo:inline font-weight="bold"> first
                                            number</fo:inline>,<fo:inline font-weight="bold"> press the
                                            multiply (× or *) button</fo:inline>, <fo:inline font-weight="bold">enter the second number,</fo:inline>
                                        then <fo:inline font-weight="bold">press equals
                                            (=)</fo:inline> to get the result. </fo:block></fo:block-container>
                                    <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">It shows the total
                                        when one number is repeated multiple times.</fo:block></fo:block-container>
                                </fo:block></fo:block-container>
                            </fo:block>
                            <fo:block role="Sect" id="unique_8" chfox:nd-id="how_to_subtract_numbers">
                                <fo:block-container font-size="1.7em" space-after="0.5em" margin-left="0" margin-right="0" space-before="1em" page-break-after="avoid" id="ariaid-title12"><fo:block end-indent="0" start-indent="0" role="H2"><fo:inline>How to Multiply numbers</fo:inline></fo:block></fo:block-container>
                                <fo:block-container space-after="0" margin-left="0" margin-right="0" space-before="0"><fo:block end-indent="0" start-indent="0">
                                    <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="0.5em"><fo:block end-indent="0" start-indent="0">Here you will
                                        find instructions about using the multiply feature of JPS
                                        calculator</fo:block></fo:block-container>
                                    <fo:block-container space-after="1em" space-before="1em" id="unique_8_Connect_42_prereq_fmq_m3k_5fc" chfox:nd-id="prereq_fmq_m3k_5fc"><fo:block end-indent="0" start-indent="0" role="Sect">
                                        <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">To sucessfully
                                            multiply numbers, you must know what is multiply</fo:block></fo:block-container>
                                    </fo:block></fo:block-container>
                                    <fo:block-container space-after="1em" space-before="1em" id="unique_8_Connect_42_context_w4j_s3l_5fc" chfox:nd-id="context_w4j_s3l_5fc"><fo:block end-indent="0" start-indent="0" role="Sect"/></fo:block-container>
                                    <fo:block role="Sect">
                                        <fo:list-block relative-align="baseline" provisional-label-separation="3pt" provisional-distance-between-starts="40px" space-after="1.33em" space-before="1.33em" id="unique_8_Connect_42_steps_x4j_s3l_5fc" chfox:nd-id="steps_x4j_s3l_5fc">
                                            <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end" font-family="Times New Roman,Liberation Serif,DejaVu Serif,Symbol,Segoe UI Symbol,FreeSerif,ZapfDingbats">1. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>
                                                <fo:inline>Enter the first
                                                  number.</fo:inline>
                                            </fo:block></fo:list-item-body></fo:list-item>
                                            <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end" font-family="Times New Roman,Liberation Serif,DejaVu Serif,Symbol,Segoe UI Symbol,FreeSerif,ZapfDingbats">2. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>
                                                <fo:inline>Choose the multiply (x)
                                                  button.</fo:inline>
                                            </fo:block></fo:list-item-body></fo:list-item>
                                            <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end" font-family="Times New Roman,Liberation Serif,DejaVu Serif,Symbol,Segoe UI Symbol,FreeSerif,ZapfDingbats">3. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>
                                                <fo:inline>Enter the second
                                                  number.</fo:inline>
                                            </fo:block></fo:list-item-body></fo:list-item>
                                            <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end" font-family="Times New Roman,Liberation Serif,DejaVu Serif,Symbol,Segoe UI Symbol,FreeSerif,ZapfDingbats">4. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>
                                                <fo:inline>Choose the equlas (=)
                                                  button.</fo:inline>
                                            </fo:block></fo:list-item-body></fo:list-item>
                                        </fo:list-block>
                                    </fo:block>
                                    <fo:block-container space-after="1em" space-before="1em" id="unique_8_Connect_42_result_nyf_djk_5fc" chfox:nd-id="result_nyf_djk_5fc"><fo:block end-indent="0" start-indent="0" role="Sect">
                                        <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">The results
                                            from multplications are displayed</fo:block></fo:block-container>
                                    </fo:block></fo:block-container>
                                    <fo:block-container space-after="1em" space-before="1em" id="unique_8_Connect_42_example_sm3_hjk_5fc" chfox:nd-id="example_sm3_hjk_5fc"><fo:block end-indent="0" start-indent="0" role="Sect">
                                        <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">You want to
                                            multiply 2 from 3 . The equation will look like 3*2=6.
                                            You enter 3 , press X , enter 2, press equlas</fo:block></fo:block-container>
                                        <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">The result 6
                                            displays on screen</fo:block></fo:block-container>
                                    </fo:block></fo:block-container>
                                </fo:block></fo:block-container>
                            </fo:block>
                        </fo:block></fo:block-container>
                    </fo:block>
                </fo:block></fo:block-container>
            </fo:block>
        </fo:block></fo:block-container>
    </fo:block></fo:block-container>
</fo:block></fo:flow></fo:page-sequence></fo:root>