                            <fo:block-container font-size="2em" line-height="1.1em" space-after="0.5em" margin-left="0" margin-right="0" space-before="0" page-break-after="avoid" id="ariaid-title1"><fo:block end-indent="0" start-indent="0" role="H1"><fo:marker marker-class-name="chaptertitle-only"><fo:inline/> <!--content(text)--><fo:inline>sum-up</fo:inline></fo:marker><fo:marker marker-class-name="chaptertitle-no-prefix"><fo:inline/> 1 - <!--content(text)--><fo:inline>sum-up</fo:inline></fo:marker><fo:marker marker-class-name="chaptertitle"><fo:inline/> | 1 - <!--content(text)--><fo:inline>sum-up</fo:inline></fo:marker><fo:inline>Chapter 1. </fo:inline><fo:inline>sum-up</fo:inline></fo:block></fo:block-container>
                            <fo:block role="Sect" id="unique_1" chfox:nd-id="what_is_subtract_of_numbers">
                                <fo:block-container font-size="1.7em" space-after="0.5em" margin-left="0" margin-right="0" space-before="1em" page-break-after="avoid" id="ariaid-title2"><fo:block end-indent="0" start-indent="0" role="H2"><fo:inline>What is Sum-up of numbers</fo:inline></fo:block></fo:block-container>
                                <fo:block-container space-after="0" margin-left="0" margin-right="0" space-before="0"><fo:block end-indent="0" start-indent="0">
                                    <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="0.5em"><fo:block end-indent="0" start-indent="0">Here you will
                                        learn what is sum-up</fo:block></fo:block-container>
                                    <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">Subtraction is the
                                        process of finding the <fo:inline font-weight="bold">addition between two
                                            numbers</fo:inline> by taking adding number into another. </fo:block></fo:block-container>
                                    <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">When using a
                                        calculator, you <fo:inline font-weight="bold">enter the
                                            first number</fo:inline>, <fo:inline font-weight="bold">press the plus (+)</fo:inline>
                                        button, <fo:inline font-weight="bold">enter the
                                            second number</fo:inline>, <fo:inline font-weight="bold">then press equals (=)</fo:inline> to
                                        get the result.</fo:block></fo:block-container>
                                    <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0"> It shows how much
                                        remains after adding one value into another.</fo:block></fo:block-container>
                                </fo:block></fo:block-container>
                            </fo:block>
                            <fo:block role="Sect" id="unique_2" chfox:nd-id="how_to_subtract_numbers">
                                <fo:block-container font-size="1.7em" space-after="0.5em" margin-left="0" margin-right="0" space-before="1em" page-break-after="avoid" id="ariaid-title3"><fo:block end-indent="0" start-indent="0" role="H2"><fo:inline>How to sum-up numbers</fo:inline></fo:block></fo:block-container>
                                <fo:block-container space-after="0" margin-left="0" margin-right="0" space-before="0"><fo:block end-indent="0" start-indent="0">
                                    <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="0.5em"><fo:block end-indent="0" start-indent="0">Here you will
                                        find instructions about using the sum-up feature of JPS
                                        calculator</fo:block></fo:block-container>
                                    <fo:block-container space-after="1em" space-before="1em" id="unique_2_Connect_42_prereq_fmq_m3k_5fc" chfox:nd-id="prereq_fmq_m3k_5fc"><fo:block end-indent="0" start-indent="0" role="Sect">
                                        <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">To sucessfully
                                            sum-up numbers, you must know what is sum-up</fo:block></fo:block-container>
                                    </fo:block></fo:block-container>
                                    <fo:block-container space-after="1em" space-before="1em" id="unique_2_Connect_42_context_idh_sgl_5fc" chfox:nd-id="context_idh_sgl_5fc"><fo:block end-indent="0" start-indent="0" role="Sect"/></fo:block-container>
