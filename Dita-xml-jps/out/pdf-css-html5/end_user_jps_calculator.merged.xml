        <steps class="- topic/ol task/steps " id="unique_2_Connect_42_steps_jdh_sgl_5fc" nd:nd-id="steps_jdh_sgl_5fc"><step class="- topic/li task/step ">
                <cmd class="- topic/ph task/cmd ">Enter the first number.</cmd>
